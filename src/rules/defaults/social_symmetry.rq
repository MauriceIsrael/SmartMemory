# Makes foaf:knows symmetric (if A knows B, then B knows A) (SCOPED)
PREFIX foaf: <http://xmlns.com/foaf/0.1/>
PREFIX : <http://semanticmemory.org/user#>

CONSTRUCT {
    ?person2 foaf:knows ?person1 .
}
WHERE {
    ?person1 foaf:knows ?person2 .
    FILTER(STRSTARTS(STR(?person1), STR(:)) && STRSTARTS(STR(?person2), STR(:)))
    FILTER NOT EXISTS { ?person2 foaf:knows ?person1 }
}
