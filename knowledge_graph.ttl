@prefix ns1: <:> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sem: <http://semanticmemory.org/vocab#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

rdf:HTML a rdfs:Class,
        rdfs:Datatype,
        rdfs:Resource ;
    owl:sameAs rdf:HTML .

rdf:PlainLiteral a rdfs:Class,
        rdfs:Datatype,
        rdfs:Resource ;
    owl:sameAs rdf:PlainLiteral .

rdf:Property a rdfs:Class,
        rdfs:Resource ;
    owl:sameAs rdf:Property .

rdf:XMLLiteral a rdfs:Class,
        rdfs:Datatype,
        rdfs:Resource ;
    owl:sameAs rdf:XMLLiteral .

rdf:langString a rdfs:Class,
        rdfs:Datatype,
        rdfs:Resource ;
    owl:sameAs rdf:langString .

rdfs:Class a rdfs:Class,
        rdfs:Resource ;
    rdfs:label "Class" ;
    rdfs:comment "The class of classes." ;
    rdfs:isDefinedBy rdfs: ;
    rdfs:seeAlso rdfs: ;
    rdfs:subClassOf rdfs:Resource ;
    owl:sameAs rdfs:Class .

rdfs:Container a rdfs:Class,
        rdfs:Resource ;
    rdfs:label "Container" ;
    rdfs:comment "The class of RDF containers." ;
    rdfs:isDefinedBy rdfs: ;
    rdfs:seeAlso rdfs: ;
    rdfs:subClassOf rdfs:Resource ;
    owl:sameAs rdfs:Container .

rdfs:ContainerMembershipProperty a rdfs:Class,
        rdfs:Resource ;
    rdfs:label "ContainerMembershipProperty" ;
    rdfs:comment "The class of container membership properties, rdf:_1, rdf:_2, ..., all of which are sub-properties of 'member'." ;
    rdfs:isDefinedBy rdfs: ;
    rdfs:seeAlso rdfs: ;
    rdfs:subClassOf rdf:Property ;
    owl:sameAs rdfs:ContainerMembershipProperty .

rdfs:Datatype a rdfs:Class,
        rdfs:Resource ;
    rdfs:label "Datatype" ;
    rdfs:comment "The class of RDF datatypes." ;
    rdfs:isDefinedBy rdfs: ;
    rdfs:seeAlso rdfs: ;
    rdfs:subClassOf rdfs:Class,
        rdfs:Resource ;
    owl:sameAs rdfs:Datatype .

rdfs:Literal a rdfs:Class,
        rdfs:Datatype,
        rdfs:Resource ;
    rdfs:label "Literal" ;
    rdfs:comment "The class of literal values, eg. textual strings and integers." ;
    rdfs:isDefinedBy rdfs: ;
    rdfs:seeAlso rdfs: ;
    rdfs:subClassOf rdfs:Resource ;
    owl:sameAs rdfs:Literal .

rdfs:Resource a rdfs:Class,
        rdfs:Resource ;
    rdfs:label "Resource" ;
    rdfs:comment "The class resource, everything." ;
    rdfs:isDefinedBy rdfs: ;
    rdfs:seeAlso rdfs: ;
    owl:sameAs rdfs:Resource .

xsd:NCName a rdfs:Class,
        rdfs:Datatype,
        rdfs:Resource ;
    owl:sameAs xsd:NCName .

xsd:NMTOKEN a rdfs:Class,
        rdfs:Datatype,
        rdfs:Resource ;
    owl:sameAs xsd:NMTOKEN .

xsd:Name a rdfs:Class,
        rdfs:Datatype,
        rdfs:Resource ;
    owl:sameAs xsd:Name .

xsd:anyURI a rdfs:Class,
        rdfs:Datatype,
        rdfs:Resource ;
    owl:sameAs xsd:anyURI .

xsd:base64Binary a rdfs:Class,
        rdfs:Datatype,
        rdfs:Resource ;
    owl:sameAs xsd:base64Binary .

xsd:boolean a rdfs:Class,
        rdfs:Datatype,
        rdfs:Resource ;
    owl:disjointWith xsd:dateTime,
        xsd:decimal ;
    owl:sameAs xsd:boolean .

xsd:byte a rdfs:Class,
        rdfs:Datatype,
        rdfs:Resource ;
    owl:sameAs xsd:byte .

xsd:date a rdfs:Class,
        rdfs:Datatype,
        rdfs:Resource ;
    owl:sameAs xsd:date .

xsd:dateTime a rdfs:Class,
        rdfs:Datatype,
        rdfs:Resource ;
    owl:disjointWith xsd:decimal ;
    owl:sameAs xsd:dateTime .

xsd:dateTimeStamp a rdfs:Class,
        rdfs:Datatype,
        rdfs:Resource ;
    owl:sameAs xsd:dateTimeStamp .

xsd:decimal a rdfs:Class,
        rdfs:Datatype,
        rdfs:Resource ;
    owl:sameAs xsd:decimal .

xsd:double a rdfs:Class,
        rdfs:Datatype,
        rdfs:Resource ;
    owl:sameAs xsd:double .

xsd:float a rdfs:Class,
        rdfs:Datatype,
        rdfs:Resource ;
    owl:sameAs xsd:float .

xsd:hexBinary a rdfs:Class,
        rdfs:Datatype,
        rdfs:Resource ;
    owl:sameAs xsd:hexBinary .

xsd:int a rdfs:Class,
        rdfs:Datatype,
        rdfs:Resource ;
    owl:sameAs xsd:int .

xsd:integer a rdfs:Class,
        rdfs:Datatype,
        rdfs:Resource ;
    owl:sameAs xsd:integer .

xsd:language a rdfs:Class,
        rdfs:Datatype,
        rdfs:Resource ;
    owl:sameAs xsd:language .

xsd:long a rdfs:Class,
        rdfs:Datatype,
        rdfs:Resource ;
    owl:sameAs xsd:long .

xsd:negativeInteger a rdfs:Class,
        rdfs:Datatype,
        rdfs:Resource ;
    owl:sameAs xsd:negativeInteger .

xsd:nonNegativeInteger a rdfs:Class,
        rdfs:Datatype,
        rdfs:Resource ;
    owl:sameAs xsd:nonNegativeInteger .

xsd:nonPositiveInteger a rdfs:Class,
        rdfs:Datatype,
        rdfs:Resource ;
    owl:sameAs xsd:nonPositiveInteger .

xsd:normalizedString a rdfs:Class,
        rdfs:Datatype,
        rdfs:Resource ;
    owl:sameAs xsd:normalizedString .

xsd:positiveInteger a rdfs:Class,
        rdfs:Datatype,
        rdfs:Resource ;
    owl:sameAs xsd:positiveInteger .

xsd:short a rdfs:Class,
        rdfs:Datatype,
        rdfs:Resource ;
    owl:sameAs xsd:short .

xsd:string a rdfs:Class,
        rdfs:Datatype,
        rdfs:Resource ;
    owl:sameAs xsd:string .

xsd:time a rdfs:Class,
        rdfs:Datatype,
        rdfs:Resource ;
    owl:sameAs xsd:time .

xsd:token a rdfs:Class,
        rdfs:Datatype,
        rdfs:Resource ;
    owl:sameAs xsd:token .

xsd:unsignedByte a rdfs:Class,
        rdfs:Datatype,
        rdfs:Resource ;
    owl:sameAs xsd:unsignedByte .

xsd:unsignedInt a rdfs:Class,
        rdfs:Datatype,
        rdfs:Resource ;
    owl:sameAs xsd:unsignedInt .

xsd:unsignedLong a rdfs:Class,
        rdfs:Datatype,
        rdfs:Resource ;
    owl:sameAs xsd:unsignedLong .

xsd:unsignedShort a rdfs:Class,
        rdfs:Datatype,
        rdfs:Resource ;
    owl:sameAs xsd:unsignedShort .

owl:Nothing a rdfs:Class,
        rdfs:Resource,
        owl:Class ;
    rdfs:subClassOf owl:Nothing,
        owl:Thing ;
    owl:equivalentClass owl:Nothing ;
    owl:sameAs owl:Nothing .

owl:Thing a rdfs:Class,
        rdfs:Resource,
        owl:Class ;
    rdfs:subClassOf owl:Thing ;
    owl:equivalentClass owl:Thing ;
    owl:sameAs owl:Thing .

false a rdfs:Class,
        rdfs:Datatype,
        rdfs:Resource,
        xsd:boolean ;
    owl:sameAs false .

true a rdfs:Class,
        rdfs:Datatype,
        rdfs:Resource,
        xsd:boolean ;
    owl:sameAs true .

